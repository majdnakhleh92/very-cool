local function GetEmojiFormat(name)
	if name == ":3" then
		return "<:migattito:1496975132843835543>"
	end

	if mutations[name] then
		return "<:" .. name .. ":" .. mutations[name] .. ">"
	elseif traits[name] then
		return "<:" .. name .. ":" .. traits[name] .. ">"
	end
end

local function CameFromDuels(owner)
	if owner and owner~="Carpet" and owner:GetAttribute("__duels_block_steal") == true then
		return ":crossed_swords:"
	else
		return ":moneybag:"
	end
end

local function IsAvailable(animal)
	local plot = animal.plot
	if not plot then return false end
	local slot = animal.slot
	if not slot then return false end

	local function GetOverhead()
		for _, part in workspace.Debris:GetChildren() do
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Exclude
			params.FilterDescendantsInstances = {part}

			local raycast = workspace:Raycast(part.Position, Vector3.new(0, -100, 0), params)
			if raycast and raycast.Instance then

				for _, Plot in workspace.Plots:GetChildren() do
					if raycast.Instance:IsDescendantOf(Plot) and Plot==plot then
						for i, v in Plot.AnimalPodiums:GetChildren() do
							if raycast.Instance:IsDescendantOf(v) and i==slot then
								return part:FindFirstChild("AnimalOverhead")
							end
						end
					end
				end
			else 
				return nil
			end
		end
	end

	local overhead = GetOverhead()
	if not overhead then return false end
	local Stolen = overhead:FindFirstChild("Stolen")

	local illegalNames = {"IN DUEL", "FUSING", "READY!", "CRAFTING"}
	if Stolen and table.find(illegalNames, Stolen.Text) and Stolen.Visible == true then return false end
	return true
end

local function FormatPets(petInfo)
	local formatted = {}

	for _, pet in petInfo do
		if type(pet) ~= "table" then continue end

		local infotbl = {"└", GetEmojiFormat(pet.mutation).."·".."💰".. pet.genText}

		if pet.traits ~= "None" then
			table.insert(infotbl, "·")
			for _, trait in pet.traits do
				local emoji = GetEmojiFormat(trait:gsub(" ", ""))
				if emoji then table.insert(infotbl, GetEmojiFormat(trait:gsub(" ", ""))) end
			end
		end

		table.insert(formatted, table.concat(infotbl, " "))
	end

	return table.concat(formatted, "\n")
end

