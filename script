local function GetAnimals()
	local animals = {}

	local Synchronizer = require(game.ReplicatedStorage:WaitForChild("Packages"):WaitForChild("Synchronizer"))
	local AnimalsShared = require(game.ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Animals"))
	local NumberUtils   = require(game.ReplicatedStorage:WaitForChild("Utils"):WaitForChild("NumberUtils"))
	local AnimalsData = require(game.ReplicatedStorage:WaitForChild("Datas"):WaitForChild("Animals"))

	local function GetEntryPet(tbl, petName)
		for _, pet in tbl do
			if pet.entryname == petName then return pet end
		end
		return false
	end

	for _, workspacePlot in workspace.Plots:GetChildren() do
		local plot = Synchronizer:Get(workspacePlot.Name)
		if not plot then continue end

		local animalList = plot:Get("AnimalList")
		if not animalList then continue end

		for slot, podium in animalList do
			if type(podium) ~= "table" then continue end

			local aInfo = AnimalsData[podium.Index]
			if aInfo then
				local aName = podium.Index or aInfo.Name
				local mutation = podium.Mutation or "None"
				local owner = plot:Get("Owner")
				local Traits = podium.Traits or "None"
				local genValue = AnimalsShared:GetGeneration(aName, podium.Mutation, podium.Traits, nil)
				local genText = "$"..NumberUtils:ToString(genValue).."/s"
				if owner == game.Players.LocalPlayer then continue end
				if CameFromDuels(owner)==true and Settings["SkipDuels"]==true then continue end

				if not GetEntryPet(animals, aName) then 
					table.insert(animals, {entryname=aName})
				end

				for _, petTable in animals do
					if petTable.entryname == aName then
						table.insert(petTable, {
							name = aInfo.DisplayName or aName,
							genText = genText,
							genValue = genValue,
							mutation = mutation,
							traits = Traits,
							owner = owner,
							slot = slot,
							plot = workspacePlot,
						})
					end
				end
			end
		end
	end

	for i, v in animals do
		table.sort(v, function(a, b) return a.genValue > b.genValue end)
	end
	table.sort(animals, function(a, b) return a[1].genValue > b[1].genValue end)

	return animals
end

